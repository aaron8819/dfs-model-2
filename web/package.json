    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "agent-browser": "0.36.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
